APP_NAME=FoodieHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-service.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database: For PostgreSQL (e.g. Neon Console or Render Postgres)
DB_CONNECTION=pgsql
# If using a single connection string:
DATABASE_URL=
# Or individual credentials:
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

# Frontend & CORS Configuration
FRONTEND_URL=https://foodie-hub-alpha.vercel.app
SANCTUM_STATEFUL_DOMAINS=foodie-hub-alpha.vercel.app

# Cross-domain session / cookie settings
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

LOG_CHANNEL=stderr
LOG_LEVEL=info

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

RAZORPAY_KEY=
RAZORPAY_SECRET=
